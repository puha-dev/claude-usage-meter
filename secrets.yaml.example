# Copy to secrets.yaml (or add these keys to /config/esphome/secrets.yaml in Home Assistant).
# Never commit the real secrets.yaml.
wifi_ssid: "your-wifi"
wifi_password: "your-wifi-password"
# 32 random bytes, base64 — generate one at https://esphome.io/components/api.html#configuration-variables
api_encryption_key: "REPLACE_WITH_BASE64_KEY="
ota_password: "change-me"
fallback_ap_password: "change-me-too"
